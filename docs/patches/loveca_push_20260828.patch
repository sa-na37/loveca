+    kind = 'ANY'
+    if 'メンバー' in kind_jp:
+        kind = 'MEMBER'
+    elif 'ライブ' in kind_jp:
+        kind = 'LIVE'
+    return {
+        'group': group,
+        'kind': kind,
+        'min_picks': n,
